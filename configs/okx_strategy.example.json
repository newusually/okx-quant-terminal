{
  // ===========================================================================
  //  OKX 全合约 8 因子共振策略 · 唯一配置文件
  //  ---------------------------------------------------------------------------
  //  本文件允许 // 和 /* */ 注释（Go 侧读之前会自动剥掉），也允许 _ 开头的注释键。
  //  改完保存即可，程序每分钟自动检测改动并热加载，不用重启。
  //  路径：configs/okx_strategy.json
  //
  //  资金口径（2026-10-02 三期：单笔 0.01U → **0.1 美金**，封顶 1U）：
  //    · 每笔目标保证金 0.1 USDT，20x 杠杆
  //    · 合约准入：**不做品类区分**（美股 / ETF / 商品也能做），
  //      唯一门槛是「最小一手保证金 ≤ 1 USDT」——买得起就做
  //    · 0.1U 买不起 1 张的合约，下单时放大到刚好买 1 张，但绝不超过 1U
  //    · 买入条件：Score ≥ 3（8 个因子里命中 3 个及以上）**且**这根 K 线必须真跌 < -0.7%（六期）
  //    · 加仓：条件与买入完全一致，金额 = 原持仓保证金 × 1/3
  // ===========================================================================

  // ---- 总开关 ---------------------------------------------------------------
  "enabled": true,              // false = 整个策略停摆（连扫描都不做）
  "dry_run": false,             // ★★ 已切实盘：false = 真的下单。想只看信号就改回 true
  "order_via": "go",            // go = 用本策略自带的下单逻辑（按下面 entry/exit 的参数）

  // 本金（USDT）：用来算「累计收益率 = 总盈亏 ÷ 本金」。
  // 留 0 = 由「权益 − 浮盈 − 已实现盈亏」自动反推（没出入金时是准的）。
  "principal_usdt": 0,

  // ---- 合约准入（「哪些合约能买」）--------------------------------------------
  //   规则 1  不买美股 / ETF / 商品  ← ★ 已按用户要求关闭（见下面开关）
  //   规则 2  不买刚上线的（listTime 距今不足 N 天）
  //   规则 3  不买要下线的（OKX 公告中心 announcements-delistings 解析出的名单）
  //   规则 4  24h 成交额低于 min_quote_volume_24h 的不买（深度差、滑点吃本金）
  //   规则 5  最小一手保证金必须 ≤ max_order_margin_usdt，否则买不起
  "exclude_stock_etf": false,       // ★★ 2026-10-02 三期：true → **false**
                                    //   用户口径：「取消美股 etf 不做的功能，
                                    //   只要买入上限小于 1U 就做」。
                                    //   关上之后连美股 / ETF / 商品一起做，
                                    //   能不能做**只**看规则 5（最小一手 ≤ 1U）。
                                    //   想恢复：改回 true 即可，热生效。
  "exclude_new_listing_days": 30,   // 上市不足 30 天的不买（新币插针、没历史 K 线）
  "exclude_delisting": true,        // 排掉 OKX 公告里说要下线的
  "max_order_margin_usdt": 1.0,     // ★ 单笔准入上限：最小一手保证金 ≤ 1U 才买
                                    //   （用户 2026-10-02 三期：「只要买入上限小于 1U 就做」）
                                    //   ★ 三期起这是**唯一**的「能不能做这个合约」的资金判据 ——
                                    //     品类（美股/ETF/商品）不再参与过滤。

  // ---- 扫描参数 -------------------------------------------------------------
  "bar": "5m",                  // 主周期（没显式指定周期时的默认值）
  // ★★ 2026-10-02 四期：1m 下线；★ 2026-10-03 二十一期：15m 下线，只留 3m / 5m ★★
  //   两个都执行「扫描 + 开仓」；下线周期的 K 线会被每日清理整段删掉。
  //   权威定义在 internal/model/model.go 的 model.EnabledBars。
  "bars_enabled": ["3m", "5m"],   // ★ 两个周期都执行「扫描 + 开仓」
  "signal_bars": ["3m", "5m"],    // ★ 信号回算/图上展示的周期（画 🚀）
  "min_candles": 400,           // K 线不足这个根数直接跳过该合约（暖机需要）
  "top_n_by_volume": 80,        // 只算 24h 成交额前 N 名
  "min_quote_volume_24h": 1000000,  // 24h 成交额下限（USDT），低于 100 万的不做
  "exclude_inst": [],           // 想额外排除的合约，例如 ["BTC-USDT-SWAP"]
  "workers": 6,                 // 并发抓 K 线的协程数（2 核机器别超过 8）
  "candle_limit": 300,          // 单次 /market/candles 根数
  "history_pages": 2,           // 不够 min_candles 时再翻几页 /market/history-candles
  "score_threshold": 4,         // ★★ 8 因子里命中几项才算出信号（0~8）
                                //   ★ 2026-10-03 二十一期：用户口径「共振必须大于3」
                                //   = 严格大于 3 = Score ∈ {4..8}；判定是 `score >= score_threshold`，
                                //   写 4 等效于「> 3」。
  "score_threshold_map": {      // 对个别合约单独设阈值（优先级高于上面）
    // ★ 已清空：用户要的是「全市场同一个阈值」，不给 BTC/ETH 单独放宽。
  },
  // nq_signal（NQ 只读板块口径）—— 二十一期已随 NQ 板块整体下线，配置块删除。
  "signal_timeout_sec": 900,    // 单次抓 K 线超时
  "request_timeout_sec": 20,    // 单次 HTTP 超时

  // ---- 开仓 -----------------------------------------------------------------
  "entry": {
    "td_mode": "cross",         // isolated=逐仓 / cross=全仓（★ 用户在 OKX 用的是全仓）
    "pos_side": "net",          // net=单向持仓（推荐，只做多）
    "ord_type": "market",       // market=市价（信号出现就要立刻进）
    "margin_usdt": 0.1,         // ★★ 每笔目标保证金（U）—— 用户口径：「买入价格 0.1 美金就行，
                                //   最高封顶 1 美金」（2026-10-02 三期，由 0.01 改成 0.1）
                                //   0.1U × 20x = 2U 名义，比二期好买得多。
                                //   配合下面的 min_one：能按 0.1U 成交就成交，
                                //   成交不了就放大到「刚好 1 张」，硬顶 max_margin_usdt = 1U。

    // ★★ 触发信号的那根 K 线的**带符号**涨跌幅门槛 ★★（负值 = 必须真跌）
    //   用户口径（二十二期 2026-10-03）：「共振必须大于 3 且必须跌 1%」，
    //   即 Score >= 4 且 RisePct < -1（严格小于，跌恰好 -1.00% 不算）。
    //   涨跌幅 = (收盘 − 开盘) ÷ 开盘 × 100。
    //   方向语义：> 0 = 必须真涨超过它；< 0 = 必须真跌低于它；写 0 = 关闭该条件。
    //   买入扫描 / 加仓判定 / 信号入库三处走的是同一个函数（service.SignalQualified），
    //   所以图上标的 🚀 与实盘真正会下单的信号必然一致。
    //   不写这个键 = 用默认 -1。
    "min_bar_rise_pct": -1.0,
    "max_bar_drop_pct": 2.0,    // ★★ 二十二期新增：跌幅上限（%）——买入区间 -2% < 涨幅 < -1%
                                //   该根跌幅必须严格小于 2%；<=0 = 关闭；不写 = 默认 2。

    "leverage": 20,             // 杠杆
    // ★ 下面两条上限的语义是「0 = 不限」（2026-10-01 按用户要求取消限制）。
    //   注意：光把这里改成 0 是不够的，internal/conf/config.go 的归一化与
    //   internal/service/trader.go 的判定都一起改过，两处配合才真正生效。
    "max_concurrent_positions": 30, // ★ 十期：改成「持仓数量」限制，最多同时持 30 个合约。0 = 不限
                                     //   原来 8，今天被「持仓数已达上限 8」拦掉 4 笔。
                                     //   不限之后，实际约束变成账户可用余额 + risk.max_total_margin_pct。
    "cooldown_bars": 0,         // ★ 十期：冷却已取消（九期曾是 30）。0 = 同一合约可以连着开
    "daily_max_entries": 0,     // ★ 每天最多开几笔。0 = **不限**
                                //   原来 30，今天已被「当日开仓已达上限 30」拦掉 5 笔。

    // ↓★ OKX 永续的 sz 单位是「张」，不是 U。每张名义价值 = ctVal × ctMult × 价格。
    //   BTC 一张≈600U、ETH 一张≈300U、小币种一张可能只有 0.5U。
    //   margin_policy 决定「0.1U 买不起 1 张」时怎么办：
    "margin_policy": "min_one",   // min_one = 放大到刚好买 1 张，但不超过 max_margin_usdt（默认）
                                  // fixed   = 严格按 margin_usdt（0.1U），买不起就跳过
                                  //   ⚠ fixed 现在不再损失合约：239 个可交易合约的最小一手
                                  //     保证金 0.01 ~ 0.73U，全部 ≤ 0.1U
    "max_margin_usdt": 1.0        // min_one 时的单笔保证金硬上限（U），与准入上限同值
  },

  // ---- 出场（★ 2026-10-02 四期：止盈 +0.3% 保留，只关布林上轨）------------------
  //   用户口径：「不准平仓，不准爆仓，只能超时 1 小时自动平仓」——
  //   这里的「不准平仓」指的是**布林上轨那种乱平仓**，不是把止盈一起关掉。
  //   用户后续明确纠正：「止盈 1% 不平仓有问题」→ 止盈必须保留。
  //
  //   所以当前是**两条**通道：
  //     ① 止盈 +0.3%：浮盈到 +0.3% 立刻市价平 —— 保留（负责锁利）
  //     ② 超时 1 小时：到点市价平 —— 保留（唯一的兜底离场）
  //   布林上轨关闭；不设止损。
  //
  //   ★ 布林上轨为什么必须关（SNDK 那笔亏损的根因）★
  //     买入与上轨判定读的是**同一根已收盘 K 线**：那根既然涨了 >1%（入场硬条件），
  //     它的 close 本来就有很大概率已经站在 SMA20+2σ 之上 →
  //     下一轮 3 秒巡检立刻判「布林上轨」反手平掉。
  //     实测 SNDK-USDT-SWAP：23:58:22 开仓、23:58:37 平仓（相隔 15 秒），
  //     开仓价 1744.30 → 平仓价 1741.40，亏 0.17%。纯粹是「秒进秒出」的噪音。
  //
  //   ★ 实测「连止盈也关掉」的代价（2026-10-02 00:40~00:55 共 9 笔超时平仓）★
  //     6 笔「未止盈」合计 **-0.0924U**、3 笔「到点自动平仓」+0.0767U ——
  //     没有止盈锁利，超时那一刻的盈亏纯随机，净值反而是负的。
  //
  //   「加仓次数」这条出场条件已于 2026-10-01 彻底删除（用户要求取消）。
  "exit": {
    "take_profit_pct": 0.35,    // ★ 止盈：浮盈到 +0.35% 立刻市价平（★ 七期口径）
    "boll_upper_exit": false,   // ★ false = 关闭布林上轨（原 true，秒进秒出的元凶）
    "max_hold_minutes": 1440,   // ★ 超时平仓：开仓满 24 小时市价平掉（与止盈互为兜底）
                                //    实时巡检每 3 秒判一次，到点立即出，不等下一根 K 线。
    "max_hold_bars": 0,         // 按「根」算的超时（旧口径）。>0 时才生效，一般用上面的分钟
    "stop_loss_pct": 300.0      // ★ 硬止损：浮亏到 -300% 才平，物理上到不了，等效不设止损
  },

  // ---- 实时引擎（纯 Go 自动跑，不需要人盯）------------------------------------
  //   ExitSec  止盈巡检：只算在持仓的浮盈，够线立刻市价平。所以它必须快。
  //   EntrySec 买入信号扫描：全市场扫一遍，会拉几十个合约的 K 线，慢一点没事。
  "live": {
    "exit_sec": 3,              // ★ 每 3 秒看一眼持仓浮盈（实时止盈监测）
    "entry_sec": 60             // ★ 每 60 秒全市场扫一次买入信号，命中就下单
  },

  // ---- 加仓（补仓 / 摊薄均价）------------------------------------------------
  //   加仓额 = 原持仓保证金 × ratio（默认 1/3）
  //   触发   = ★★ 纯价格条件（七期 2026-10-02，用户口径）★★
  //            ① 收盘价比买入价低超过 drop_pct%（1%）② 该根涨幅 > bar_rise_pct%（1%）
  //   次数   = **不限**（max_times = 0）
  //   判定顺序：
  //     ① 加仓开关开着
  //     ② 只取「开仓之后」的已收盘 K 线（开仓前的走势不算）
  //     ③ 过价格条件（收盘价 < 买入价×(1−1%) 且 该根涨幅 > 1%）
  //     ④ 距上次加仓至少 min_gap_bars 根（同一根 K 线只加一次）
  //   加仓不新开持仓行：张数 / 加权均价 / 保证金就地合并进原行。
  //
  //   ★ 历史变迁：一期「先跌后转涨」→ 二期改与买入一致 → 七期改回价格条件
  //     （相对**买入价**低 1%，不是相对窗口低点）。lookback_bars / only_when_price_up 废弃。
  "addon": {
    "enabled": false,           // ★★ 二十二期：先停用加仓（用户「先不用加仓了 先要买入准确」）★★
    "mode": "price",            // ★★ 十期：切成价格模式；八期曾默认 resonance ★★
                                //   "resonance" 共振模式：score > score_threshold
                                //              且 该根涨幅 > bar_rise_pct（严格大于）
                                //   "price"     价格模式（二十二期）：score > score_threshold（共振）
                                //              且 收盘价比买入价低超 drop_pct%
                                //              且 该根涨幅 > price_rise_pct（严格大于）
    "score_threshold": 3,       // 加仓分数门槛。★ 严格大于（score > 3 = Score≥4，与买入「共振>3」一致）
                                //   二十二期起价格模式也查分。写 0 = 用顶层联动
    "ratio": 0.3333333333,      // 加仓额 = 原持仓保证金 × ratio（= 1/3）。仅 margin_usdt <= 0 时生效
    "rise_bar": "auto",         // ★ auto = 用「该仓位自己的周期」（1m 开的按 1m 判，15m 开的按 15m 判）
    "max_times": 0,             // ★★ 0 = **不限**（用户口径「加仓没有任何限制」）
    "min_gap_bars": 1,          // 两次加仓至少隔 1 根（同一根只加一次）
    "margin_usdt": 0.1,         // ★★ 二十二期：0 → 0.1（用户「买入和加仓都是 0.1 美金」）
    "drop_pct": 2.0,            // 【价格模式】★ 二十二期：3.0 → 2.0。收盘价比买入价低超过 2% 才加
    "bar_rise_pct": 0.7,        // 【共振模式】该根涨幅 > 0.7% 才加（二十二期不用，保留备用）
    "price_rise_pct": 0.4,      // 【价格模式】★ 二十二期：0.3 → 0.4。该根涨幅 > 0.4% 才加（「反弹启动」）
    "lookback_bars": 24,        // 【已废弃】旧口径「回看多少根找低点」
    "only_when_price_up": true  // 【已废弃】旧口径「只在上行时加」
  },

  // ---- 资金与风控 -----------------------------------------------------------
  //   ★ 已按「账户只有几毛到几 U」重设：百分比类的保护按笔算，
  //     不能用大账户默认值（5U 可用余额 / 30% 总保证金），否则 0.1U 一笔都开不出来。
  "risk": {
    "account_equity_stop": 0.0,     // 权益低于此值全停（0 = 不启用）
    "daily_loss_stop_pct": 50.0,    // 当日亏损超过权益的 N% 停止开仓
    "max_total_margin_pct": 100.0,  // 总保证金不超过权益的 N%
    "min_available_usdt": 0.1,      // 可用余额低于 N U 停止开仓
    "consecutive_loss_pause": 5,    // 连亏 N 笔暂停 2 小时
    "pause_on_api_error": 10        // 连续 N 次 API 错误暂停
  },

  // ---- AI 解读 --------------------------------------------------------------
  "ai": {
    "enabled": true,
    "provider": "openai_compatible",              // 兼容 OpenAI 格式的都行
    "base_url": "https://api.deepseek.com/v1",    // 换成你实际用的服务
    "api_key": "",                                // ★ 填上你的 Key；留空则不调用
    "model": "deepseek-chat",
    "timeout_sec": 30,
    "max_calls_per_day": 50,                      // 硬上限，防跑飞
    "only_on_order": true                         // true = 只有真下单才调用，省钱
  },

  // ---- OKX 接口 -------------------------------------------------------------
  "okx": {
    "base_url": "https://www.okx.com",            // 三个候选，程序会自动挑第一个通的
    "fallback_urls": ["https://aws.okx.com", "https://okx.com"],
    "api_key": "",   // <你的 OKX API Key>
    "secret_key": "",
    "passphrase": "",
    "simulated": false,                           // ★ 实盘。改 true = 只用模拟盘
    "proxy": ""                                   // 服务器在国内可填 "http://127.0.0.1:7890"
  },

  // ---- 存储与日志（MySQL，已彻底移除 SQLite）----------------------------------
  "store": {
    "enabled": true,
    "driver": "mysql",
    "host": "127.0.0.1",
    "port": 3306,
    "user": "okx",
    // password / dsn 故意留空 —— 口令只放一个地方，见 internal/conf/secret.go：
    //   环境变量 OKX_MYSQL_PASS  →  <项目根>\.mysql-pass  →  空
    // 本文件虽已在 .gitignore 里，但「配置文件里明文写口令」这个习惯一旦扩散
    // （比如被谁拷进 example.json）泄漏只是时间问题。
    // 设置 / 轮换口令：双击 scripts\set_db_pass.bat
    "password": "",
    "database": "okx",
    "dsn": "",
    "max_open_conns": 64,                         // 400+ 合约并发写入靠这个池
    "max_idle_conns": 32,
    "batch_size": 500,                            // 多行 INSERT 分片大小
    "keep_kline_days": 0,                         // ★ 旧字段，默认值必须是 0（与生产配置一致）。
                                                  //   归一化顺序是「先兜旧键 → 新键再沿用旧键」，
                                                  //   这里填 30 会把「两个键都没写」的情况变成
                                                  //   kline_retain_days=30 —— 让用户写的 10 静默失效。
                                                  //   已被 kline_retain_days 取代，留作老配置兼容。
    "kline_retain_days": 30,                      // ★★ K 线保留窗口（天）：四个周期都保留**最近 30 天**。
                                                  //   ★ 2026-10-02 十九期：10 → 30 ★（与生产配置同口径）
                                                  //   二期（2026-10-01）曾是 10 天。
                                                  //   ⚠ 改本值必须连带：① 往前扩分区（否则旧数据挤进
                                                  //     第一个日分区，将来整段 DROP 会误删）；
                                                  //      ② 重启服务（回补天数只在启动时读一次）。
                                                  //   由【每日任务】在凌晨执行（DROP PARTITION 为主 + 边界行兜底），
                                                  //   见 internal/service/cleanup.go 的 RunDailyMaintenance。
                                                  //   0 = 按 30 天兜底。
    "retain_days": 30,                            // ★★ 记录表保留窗口（天）：历史仓位 / 交易记录 / 交易流水 /
                                                  //   交易信号 / 权益曲线 / 运行日志表，超过一律自动删除。
                                                  //   在【月度任务】里清理（equity 每 3 秒一条，放一年是 1000 万行）。
                                                  //   0 或负数 = 按 30 天兜底。
    "log_retain_days": 30,                        // ★★ 日志保留窗口（天）：logs/ 与 apache/logs/ 下超过一个月的
                                                  //   日志文件（应用日志 + mysql error/slow log + 网页 access/error）
                                                  //   在月度任务里删除。0 = 按 30 天兜底。
    "archive_dir": "archive",                     // 月度归档目录：15m K 线按月导出成 gzip 分片放这里，
                                                  //   该目录是**独立 git 仓库**，推到 GitHub 数据仓备份。
    "archive_min_free_gb": 10,                    // ★★ 磁盘守卫：C 盘可用低于此值（GB）时，月度任务会把
                                                  //   K 线收缩到「只保留当月」。0 = 按 10 GB 兜底。
    "disable_recycle_clean": false,               // 回收站清理开关：false=清（默认，符合「清理回收站垃圾」口径）。
                                                  //   清空回收站**不可逆**，想暂时停掉就改成 true，
                                                  //   月度任务会跳过这一步并在日志里说明。
    "log_dir": "logs",
    "log_max_mb": 20,                             // 单个日志文件上限
    "log_keep": 5                                 // 保留几个历史日志
  }
}
